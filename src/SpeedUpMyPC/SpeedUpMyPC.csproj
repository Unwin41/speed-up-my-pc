<Project Sdk="Microsoft.NET.Sdk">
  <!-- For Visual Studio / `dotnet build`. build.ps1 builds the same code without any SDK. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>5</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SpeedUpMyPC</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <!-- Languages: same resource names as build.ps1 ("lang.en.txt", "lang.tr.txt", ...) -->
    <EmbeddedResource Include="lang\*.txt" LogicalName="lang.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
